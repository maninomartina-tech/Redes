# ---------------------------------------------------------------------------
# Copiá este archivo como .env y completá los valores.
# El .env nunca se sube al repositorio.
# ---------------------------------------------------------------------------

# Puerto del servidor
PORT=4000

# Dirección pública del servidor.
# Meta descarga las piezas desde acá, así que tiene que ser accesible desde
# internet (no sirve localhost). Para probar en tu máquina podés usar un túnel:
#   npx localtunnel --port 4000     ó     ngrok http 4000
PUBLIC_URL=https://tu-servidor.example

# Desde dónde se abre la app (para permitir las llamadas del navegador)
APP_ORIGIN=http://localhost:5173

# Cuánto atraso se tolera, en horas. Si el servidor estuvo caído y una
# publicación venció hace más que esto, no se sube: sale marcada como error
# para que decidas vos si todavía sirve. Así, tras una caída larga, no se
# publica todo lo atrasado de golpe.
MAX_ATRASO_HORAS=6

# Modo solo lectura: la app se conecta a Instagram únicamente para traer el
# feed y las métricas, sin publicar nada.
#
# Conviene arrancar así: no necesita la aprobación de Meta para publicar ni
# hosting pago (como no hay nada que subir a horario, el servidor puede
# dormirse). Cuando quieras la publicación automática, poné false.
MODO_SOLO_LECTURA=true

# --- Meta (Instagram / Facebook) ---
# Se sacan de https://developers.facebook.com → tu app → Configuración básica.
# La app necesita el permiso instagram_content_publish aprobado y la cuenta de
# Instagram tiene que ser Business o Creator, vinculada a una página.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# Id de tu cuenta publicitaria, para traer las campañas de Meta Ads.
# Lo ves en Meta Ads Manager, arriba: "act_123456789" (podés poner solo el número).
META_AD_ACCOUNT_ID=

# --- Análisis con IA (opcional) ---
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
